# ============================================
# ShelfCast — configuração
# Copie para .env e edite conforme necessário
# ============================================

# Servidor HTTP
HOST=0.0.0.0
PORT=8080

# Banco de dados e arquivos locais
DATA_DIR=./data
DATABASE_PATH=./data/library.db

# Sincronização
# Valores válidos: 1m, 5m, 10m, 30m, 1h, 6h, 12h, 24h
SCAN_INTERVAL=30m
DISCOVERY_INTERVAL=10m

# Metadados
ENABLE_METADATA=true
# Obtenha uma chave gratuita em https://www.themoviedb.org/documentation/api
TMDB_API_KEY=
TMDB_ENABLED=true
TVMAZE_ENABLED=true
ANILIST_ENABLED=true
JIKAN_ENABLED=true

# Reprodução / transcodificação (FFmpeg)
ENABLE_TRANSCODE=true
# Aceleração de hardware para transcodificar (ex.: 4K/HEVC). auto = detecta.
# Opções: auto, qsv (Intel), nvenc (NVIDIA), vaapi, none
ENABLE_HW_TRANSCODE=true
HW_ACCEL=auto
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Logs
LOG_LEVEL=info

# Performance
HTTP_TIMEOUT=30000
MAX_SCAN_CONCURRENCY=2
METADATA_RATE_LIMIT_MS=250
